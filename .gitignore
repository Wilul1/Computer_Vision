.venv/
__pycache__/
*.pyc
.gradio/

# Videos and weights are too big for git: rebuild them with scripts/get_data.py.
data/raw/*
data/train/*
data/val/*
data/test/*
!data/*/.gitkeep
models/*.pt
models/*.task
outputs/*
!outputs/metrics/
!outputs/samples/
!outputs/.gitkeep
# Per-frame features of the val/test videos (~14 MB): lets evaluate.py reproduce
# every reported number from the tag without the 3 GB of videos.
!outputs/cache/
outputs/cache/*
!outputs/cache/val/
!outputs/cache/test/
*.mp4
*.avi
*.mov
# Test-case clips are small (1.4 MB in total, MIT-licensed GMDCSA24 cuts).
!tests/cases/*.mp4
# Milestone 4 backup demo reel (annotated test cases, <10 MB).
!docs/backup_demo_m4.mp4
node_modules/
package-lock.json
